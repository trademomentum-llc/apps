[Unit]
Description=Rational Reserve - Morphogenetic Maintainer (NON-PRODUCTION SCAFFOLDING)
Documentation=https://github.com/morphlex/rational-reserve
After=network.target

[Service]
Type=oneshot
ExecStart=/usr/bin/env morphlex daemon maintenance --run
StandardOutput=journal
StandardError=journal
SyslogIdentifier=rr-morpho

# Security hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/.local/share/morphlex %t/morphlex
PrivateTmp=true

# Resource limits
MemoryMax=2G
CPUQuota=100%
