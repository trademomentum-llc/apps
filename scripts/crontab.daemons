# Rational Reserve Daemon Crontab — NON-PRODUCTION TEMPLATE ONLY
#
# Do not install this file directly on production hosts. Prefer the guarded
# user-systemd scaffolding in scripts/install-daemons.sh for local tests, and
# generated/attested service units for production.
#
# To use this template in a disposable local environment, replace APP_ROOT with
# an explicit clone path owned by the invoking user. Never use hardcoded
# /home/llc paths or root-owned installs.

SHELL=/bin/bash
APP_ROOT=/opt/rr/apps
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

# Start daemons at boot (with delay for network)
@reboot sleep 30 && "$APP_ROOT/scripts/start-daemons.sh" >> "$APP_ROOT/logs/cron-startup.log" 2>&1

# Daily maintenance at 4 AM
0 4 * * * "$APP_ROOT/target/release/morphlex" daemon maintenance --run >> "$APP_ROOT/logs/maintenance.log" 2>&1

# Hourly integrity check log
0 * * * * "$APP_ROOT/target/release/morphlex" daemon integrity --check-only >> "$APP_ROOT/logs/integrity-hourly.log" 2>&1 || true
