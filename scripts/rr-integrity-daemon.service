[Unit]
Description=Rational Reserve - System Integrity Daemon (NON-PRODUCTION SCAFFOLDING)
Documentation=https://github.com/morphlex/rational-reserve
After=network.target
Wants=network.target

[Service]
Type=simple
Environment=RR_MONITOR_PATH=%h/apps
ExecStart=/usr/bin/env morphlex daemon integrity --monitor ${RR_MONITOR_PATH}
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=rr-integrity

# Resource limits
MemoryMax=512M
CPUQuota=25%

[Install]
WantedBy=default.target
