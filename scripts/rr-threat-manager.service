[Unit]
Description=Rational Reserve - Threat Intelligence Manager (NON-PRODUCTION SCAFFOLDING)
Documentation=https://github.com/morphlex/rational-reserve
After=network.target
Wants=network.target

[Service]
Type=simple
Environment=RR_SCAN_INTERVAL=30
ExecStart=/usr/bin/env morphlex daemon threat --scan-interval ${RR_SCAN_INTERVAL}
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=rr-threat

# Resource limits
MemoryMax=1G
CPUQuota=50%

[Install]
WantedBy=default.target
